#!/bin/sh
# Recale les <lastmod> du sitemap sur les pages du commit, puis les embarque.
# Installation : git config core.hooksPath hooks   (déjà fait sur ce poste)
set -e

command -v node >/dev/null 2>&1 || { echo "pre-commit: node absent, sitemap non recalé" >&2; exit 0; }

node "$(git rev-parse --show-toplevel)/sync-sitemap.js"
git add "$(git rev-parse --show-toplevel)/sitemap.xml"
