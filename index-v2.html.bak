<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Pharmacie Charnal à Quéven - Votre pharmacie familiale depuis près de 40 ans">
    <title>Pharmacie Charnal - Quéven | Votre pharmacie de confiance</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style-v2.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="index-v2.html" class="nav-logo-link">
                <div class="nav-logo">
                    <div class="logo-icon">
                        <img src="images /Pharmacie Charnal logo.png" alt="Logo Pharmacie Charnal" style="width: 100%; height: 100%; object-fit: contain;">
                    </div>
                    <div class="logo-text">
                        <span class="logo-name">Pharmacie Charnal</span>
                        <span class="logo-tagline">Quéven</span>
                    </div>
                </div>
            </a>
            <ul class="nav-links">
                <li><a href="index-v2.html" class="nav-link active">Accueil</a></li>
                <li><a href="histoire-v2.html" class="nav-link">Notre Histoire</a></li>
                <li><a href="services-v2.html" class="nav-link">Services</a></li>
                <li><a href="blog-v2.html" class="nav-link">Actualités</a></li>
                <li><a href="contact-v2.html" class="nav-link nav-link-cta">Contact</a></li>
            </ul>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-background">
            <div class="hero-shape hero-shape-1"></div>
            <div class="hero-shape hero-shape-2"></div>
        </div>
        <div class="container hero-container">
            <div class="hero-content">
                <div class="hero-badge fade-in">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                        <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                    <span>Depuis près de 40 ans à votre service</span>
                </div>
                <h1 class="hero-title fade-in">
                    Votre santé,<br>
                    <span class="gradient-text">notre priorité</span>
                </h1>
                <p class="hero-description fade-in">
                    Une pharmacie familiale au cœur de Quéven, où tradition et modernité se rencontrent pour vous offrir des soins personnalisés et attentifs.
                </p>
                <div class="hero-buttons fade-in">
                    <a href="contact-v2.html" class="btn btn-primary">
                        <span>Nous contacter</span>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                            <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                    <a href="#services" class="btn btn-secondary">
                        <span>Nos services</span>
                    </a>
                </div>
            </div>
            <div class="hero-image fade-in">
                <div class="hero-placeholder">
                    <span>Photo de la pharmacie</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Quick Info -->
    <section class="quick-info">
        <div class="container">
            <div class="info-cards">
                <div class="info-card fade-up">
                    <div class="info-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2"/>
                            <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </div>
                    <div class="info-content">
                        <h3>Adresse</h3>
                        <p>10 Place de Toulouse<br>56530 Quéven</p>
                    </div>
                </div>
                <div class="info-card fade-up" style="animation-delay: 0.1s">
                    <div class="info-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </div>
                    <div class="info-content">
                        <h3>Téléphone</h3>
                        <p><a href="tel:0297397322">02 97 39 73 22</a></p>
                    </div>
                </div>
                <div class="info-card fade-up" style="animation-delay: 0.2s">
                    <div class="info-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                            <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="info-content">
                        <h3>Horaires</h3>
                        <p>Lun-Ven: 8h30-12h30 / 14h-20h<br>Sam: 9h-12h30</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services -->
    <section id="services" class="services">
        <div class="container">
            <div class="section-header">
                <span class="section-badge fade-in">Nos services</span>
                <h2 class="section-title fade-in">
                    Des solutions complètes pour<br>
                    <span class="gradient-text">votre bien-être</span>
                </h2>
            </div>
            <div class="services-grid">
                <a href="services-v2.html#ordonnances" class="service-card fade-up">
                    <div class="service-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
                            <rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
                            <rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
                            <rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </div>
                    <h3>Délivrance d'ordonnances</h3>
                    <p>Conseils personnalisés et suivi pharmaceutique attentif</p>
                </a>
                <a href="services-v2.html#drive-livraison" class="service-card fade-up" style="animation-delay: 0.1s">
                    <div class="service-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="2"/>
                            <circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </div>
                    <h3>Drive & Livraison</h3>
                    <p>Récupération rapide ou livraison à domicile le jour même</p>
                </a>
                <a href="services-v2.html#vaccinations" class="service-card fade-up" style="animation-delay: 0.2s">
                    <div class="service-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke="currentColor" stroke-width="2"/>
                            <polyline points="22 4 12 14.01 9 11.01" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </div>
                    <h3>Vaccinations</h3>
                    <p>Service de vaccination sur rendez-vous par nos pharmaciens</p>
                </a>
                <a href="services-v2.html#produits-naturels" class="service-card fade-up" style="animation-delay: 0.3s">
                    <div class="service-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M12 2v20M2 12h20" stroke="currentColor" stroke-width="2"/>
                            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </div>
                    <h3>Produits naturels</h3>
                    <p>Phytothérapie, aromathérapie et compléments alimentaires</p>
                </a>
                <a href="services-v2.html#teleconsultation" class="service-card fade-up" style="animation-delay: 0.4s">
                    <div class="service-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="2" y="7" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2"/>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </div>
                    <h3>Téléconsultation</h3>
                    <p>Consultation médicale à distance depuis la pharmacie</p>
                </a>
                <a href="services-v2.html#parapharmacie" class="service-card fade-up" style="animation-delay: 0.5s">
                    <div class="service-icon">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z" stroke="currentColor" stroke-width="2"/>
                            <line x1="16" y1="8" x2="2" y2="22" stroke="currentColor" stroke-width="2"/>
                            <line x1="17.5" y1="15" x2="9" y2="15" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </div>
                    <h3>Parapharmacie</h3>
                    <p>Dermatologie, cosmétiques et soins personnalisés</p>
                </a>
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="why-us">
        <div class="why-us-background">
            <div class="organic-shape organic-shape-1"></div>
            <div class="organic-shape organic-shape-2"></div>
        </div>
        <div class="container">
            <div class="section-header">
                <span class="section-badge fade-in">Pourquoi nous choisir</span>
                <h2 class="section-title fade-in">
                    Une pharmacie familiale<br>
                    <span class="gradient-text">à votre écoute</span>
                </h2>
            </div>
            <div class="why-grid">
                <div class="why-card fade-up">
                    <div class="why-number">01</div>
                    <h3>40 ans d'expérience</h3>
                    <p>Une pharmacie familiale ancrée dans le cœur de Quéven depuis près de quatre décennies</p>
                </div>
                <div class="why-card fade-up" style="animation-delay: 0.1s">
                    <div class="why-number">02</div>
                    <h3>Équipe dévouée</h3>
                    <p>Des pharmaciens qualifiés et à l'écoute, disponibles pour vous conseiller personnellement</p>
                </div>
                <div class="why-card fade-up" style="animation-delay: 0.2s">
                    <div class="why-number">03</div>
                    <h3>Accessible à tous</h3>
                    <p>Parking adapté, entrée PMR et services facilitant l'accès aux soins pour chacun</p>
                </div>
                <div class="why-card fade-up" style="animation-delay: 0.3s">
                    <div class="why-number">04</div>
                    <h3>Approche naturelle</h3>
                    <p>Large sélection de produits bio, naturels et phytothérapie pour une santé au naturel</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-col footer-about">
                    <div class="footer-logo">
                        <div class="logo-icon">
                            <img src="images /Pharmacie Charnal logo.png" alt="Logo Pharmacie Charnal" style="width: 100%; height: 100%; object-fit: contain;">
                        </div>
                        <div>
                            <div class="footer-logo-name">Pharmacie Charnal</div>
                            <div class="footer-logo-tagline">Quéven</div>
                        </div>
                    </div>
                    <p>Votre pharmacie familiale depuis près de 40 ans. Une tradition de soins personnalisés et attentifs.</p>
                    <div class="footer-social">
                        <h4>Suivez-nous</h4>
                        <div class="social-links">
                            <a href="#" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Instagram">
                                <svg viewBox="0 0 24 24" fill="none">
                                    <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
                                </svg>
                            </a>
                            <a href="#" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Facebook">
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="footer-col">
                    <h4>Navigation</h4>
                    <ul>
                        <li><a href="index-v2.html">Accueil</a></li>
                        <li><a href="histoire-v2.html">Notre Histoire</a></li>
                        <li><a href="services-v2.html">Services</a></li>
                        <li><a href="blog-v2.html">Actualités</a></li>
                        <li><a href="contact-v2.html">Contact</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Contact</h4>
                    <ul>
                        <li>10 Place de Toulouse</li>
                        <li>56530 Quéven</li>
                        <li><a href="tel:0297397322">02 97 39 73 22</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>Horaires</h4>
                    <ul>
                        <li>Lun-Ven: 8h30-12h30 / 14h-20h</li>
                        <li>Samedi: 9h-12h30</li>
                        <li>Dimanche: Fermé</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 Pharmacie Charnal - Tous droits réservés</p>
            </div>
        </div>
    </footer>

    <script src="animations.js"></script>
</body>
</html>
